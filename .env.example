# ==============================================================
# PDFYARA Environment Variables Configuration
# ==============================================================

# 1. Official Canonical Site URL (defaults to https://pdfyara.com in production)
NEXT_PUBLIC_SITE_URL=https://pdfyara.com

# 2. Google AdSense Publisher Client ID
# Find in Google AdSense: Account -> Settings -> Account Information -> Publisher ID
# Format: ca-pub-XXXXXXXXXXXXXXXX (where X are 16 digits)
# Example: NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
